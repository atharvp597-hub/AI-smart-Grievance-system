# AI Smart Grievance System - Backend Configuration
# Copy this file to .env and update with your values

# MongoDB Connection
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database Name
DB_NAME=grievance_db

# JWT Authentication
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Admin onboarding key (used by /api/auth/bootstrap-admin)
ADMIN_BOOTSTRAP_KEY=replace-with-admin-bootstrap-key

# Optional: Logging Level
# LOG_LEVEL=INFO

# Optional: API Prefix
# API_PREFIX=/api

# Optional: ML Model Paths (defaults to ml/models)
# DEPT_MODEL_PATH=../ml/models/dept_model
# PRIORITY_MODEL_PATH=../ml/models/priority_model

# Optional: Confidence Threshold for Manual Review
# LOW_CONFIDENCE_THRESHOLD=0.55

# Gemini API key for AI summarization and reasoning
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=8
# GEMINI_MAX_RETRIES=2

# Resend email API for OTP delivery
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Acme <onboarding@resend.dev>

# OTP verification settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFIED_EMAIL_WINDOW_MINUTES=10
OTP_DEV_MODE=true
OTP_INCLUDE_DEBUG_OTP=true

# Windows note:
# If uvicorn reload hangs or keeps restarting, run the backend with:
#   python run_server.py
# The stable launcher uses port 8000.
